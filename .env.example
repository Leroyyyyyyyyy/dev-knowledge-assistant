# Copy to .env and fill in. Never commit .env.
# Bearer token Dify's HTTP node sends to /api/*. At least 16 characters.
DKA_SERVICE_TOKEN=replace-with-a-long-random-string
# Optional overrides (defaults shown).
# DKA_EMBED_MODEL=BAAI/bge-m3
# DKA_EMBED_BATCH_SIZE=1
# DKA_TOP_K_DEFAULT=8
# DKA_TOP_K_MAX=20
