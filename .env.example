# Copy to .env and fill in. Never commit .env.
# Bearer token Dify's HTTP node sends to /api/*. At least 16 characters.
DKA_SERVICE_TOKEN=replace-with-a-long-random-string
# Optional overrides (defaults shown).
# DKA_EMBED_MODEL=BAAI/bge-m3
# DKA_EMBED_BATCH_SIZE=1
# DKA_TOP_K_DEFAULT=8
# DKA_TOP_K_MAX=20

# --- Issue drafts and review pages (M3) ---
# Password for the demo operator who reviews and confirms drafts. At least 12 characters.
# DKA_OPERATOR_PASSWORD=replace-with-a-password
# The only repository Issues may be filed in (a test repository you control).
# DKA_ISSUE_REPO=owner/name
# DKA_PUBLIC_BASE_URL=http://localhost:8077
# DKA_SESSION_HOURS=8
# DKA_COOKIE_SECURE=false
